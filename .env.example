# QMAPS Environment Variables
# Copy this file to .env and fill in real values from your project.
# NEVER commit .env to git.

# Lovable Cloud / Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# SEO + consent kit: public tag IDs (not secrets). Empty = tool off.
# They load only after the visitor accepts cookies (Québec Law 25 banner).
VITE_GA4_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
